# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Consumed by Auth.js (NextAuth) — not read directly by app code.
NEXTAUTH_URL=http://localhost:4000

# SQLite database path (default: ./data/familychart.db)
# DB_PATH=./data/familychart.db

# Largest restore upload, in megabytes (default 512). The zip streams to a temporary file.
# A reverse proxy must allow at least this much (nginx: client_max_body_size). Managed
# hosting's edge accepts at most 100 MB per request, so a managed instance sets about 95.
# FC_RESTORE_MAX_UPLOAD_MB=512

# Reverse proxy (ADR-0007): set true when TLS terminates before the app (NPM, Traefik, Caddy).
# Default false for direct/local exposure. Docker compose sets true.
# BEHIND_REVERSE_PROXY=true

# Trusted XFF hop count when BEHIND_REVERSE_PROXY=true. Default 1 (single NPM).
# Use 2 for Cloudflare → nginx. Managed provisioner sets 2 automatically.
# TRUST_PROXY_DEPTH=1

# Entra sign-in. Default false. When unset, System Settings (auth.entra.enabled) applies.
# Local credentials stay available either way.
# FC_AUTH_ENTRA_ENABLED=false

AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=your-tenant-id
# Optional: grant app-only "User.Read.All" + "GroupMember.Read.All" on this app
# registration to enable hourly background revocation (ADR-0009). Sign-in
# works without this grant — it just won't get the hourly Graph revalidation.

# Entra ID Security Group Object IDs (Azure Portal → Entra ID → Groups → Object ID)
ENTRA_GROUP_ADMIN=
ENTRA_GROUP_MANAGER=
ENTRA_GROUP_READWRITE=
ENTRA_GROUP_READONLY=
ENTRA_GROUP_REPORTS=

# FC_ENCRYPTION_MODE=none
# Self-host at-rest encryption (ADR-0003): none (default) | env | keyserver
# FC_ENCRYPTION_MODE=none

# Env-mode passphrases (64-char hex). Required when FC_ENCRYPTION_MODE=env.
# Uploads written while encryption is on use an FCE1 header. A plaintext file
# already on disk is not encrypted at boot and cannot be read until replaced.
# FC_DB_KEY=
# FC_FILE_KEY=

# Keyserver mode (managed). Required when FC_ENCRYPTION_MODE=keyserver.
# DB_KEY_SERVER_URL=https://key.familychart.app
# DB_KS_TOKEN=
# DB_WRAPPED_KEY=
# FILE_WRAPPED_KEY=
# DB_KS_CUSTOMER_ID=

# Push notifications (Web Push / VAPID) — registry keys; self-host auto-generates when unset
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URL
VAPID_SUBJECT=mailto:admin@example.com

# SMTP (registry). Used for email.available and future email features.
# FC_SMTP_HOST=
# FC_SMTP_PORT=587
# FC_SMTP_USER=
# FC_SMTP_PASSWORD=
# FC_SMTP_TLS=true

# Security policy (registry). platformLocked under managed profile.
# FC_MFA_REQUIRED=false
# FC_PASSWORD_MIN_LENGTH=10

# CRON_MODE=internal runs a built-in scheduler every 5 min — suitable for single-instance deployments.
# When unset (or not internal), use external cron: GET /api/cron from a crontab with the x-cron-secret header (CRON_SECRET is required).
# CRON_MODE=internal

# Required for external cron callers: GET /api/cron returns 401 without a matching x-cron-secret header.
# Not used when CRON_MODE=internal.
# CRON_SECRET=

# Platform profile: managed disables local bootstrap; demo arms demo mode with DEMO_MODE
# FC_PLATFORM_PROFILE=managed
# FC_PLATFORM_PROFILE=demo

# Platform demo only (ignored on self-host without FC_PLATFORM_PROFILE=demo)
# DEMO_MODE=true

# Managed-profile-only vars (ADMIN_EMAIL/ADMIN_PASSWORD, FC_GRAPH_MAIL_*, HOST_ID,
# INSTANCE_SUBDOMAIN) are set by WheelieLabs' hosting provisioner, not self-hosters —
# see docs-internal/managed-hosting.md (internal repo only).

# Medication schedule windows (minutes). When set, locks the admin control. Defaults: lead 60, overdue push offset 30.
# FC_SCHEDULE_LEAD_MINUTES=60
# FC_SCHEDULE_OVERDUE_OFFSET_MINUTES=30
# (FC_SCHEDULE_SLOT_ASSOCIATION_RADIUS_MINUTES is retired in 1.1.0 and ignored if still set.)

# Instance default timezone (IANA). When set, locks the admin control.
# FC_DEFAULT_TIMEZONE=

# Measurement system for default observation units (metric | imperial). When set, locks the admin control.
# FC_MEASUREMENT_SYSTEM=metric

# Fail-safe bound (minutes): max time since the last successful background Entra
# revalidation (or sign-in, if never yet revalidated) before re-auth is forced, re-reading
# group membership / account status. On lapse the user returns to the login page (re-auth
# is a near-silent Entra SSO bounce), not an access-denied screen. Default: 480 (8h).
# (ADR-0009 — see AUTH_MICROSOFT_ENTRA_ID_ID above for the optional Graph permission
# grant that enables the hourly revalidation itself.)
# ENTRA_SESSION_MAX_AGE_MINUTES=480
