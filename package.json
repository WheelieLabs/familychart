{
  "name": "familychart",
  "version": "1.1.1",
  "private": true,
  "bin": {
    "fc-db-convert": "./scripts/fc-db-convert-cli.ts",
    "fc-create-admin": "./scripts/fc-create-admin-cli.ts"
  },
  "scripts": {
    "predev": "node scripts/build-changelog.mjs && node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev --port 4000 --hostname 0.0.0.0 --webpack",
    "dev:clean": "rm -rf .next && npm rebuild better-sqlite3-multiple-ciphers && npm run dev",
    "postinstall": "npm rebuild better-sqlite3-multiple-ciphers",
    "fc-db-convert": "tsx scripts/fc-db-convert-cli.ts",
    "fc-create-admin": "tsx scripts/fc-create-admin-cli.ts",
    "prebuild": "node scripts/build-changelog.mjs && node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "pretypecheck": "node scripts/build-changelog.mjs",
    "test:ui": "npm run build && playwright test",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "@zip.js/zip.js": "^2.24.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "read-excel-file": "^9.3.12",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "nodemailer": "^10.1.1",
    "sharp": "^0.35.3",
    "js-yaml": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-x": "^5.28.4",
    "espree": "^11.2.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
