{
  "name": "familychart",
  "version": "1.0.2",
  "private": true,
  "bin": {
    "fc-db-convert": "./scripts/fc-db-convert-cli.ts",
    "fc-create-admin": "./scripts/fc-create-admin-cli.ts"
  },
  "scripts": {
    "predev": "node scripts/build-changelog.mjs",
    "dev": "next dev --port 4000 --hostname 0.0.0.0 --webpack",
    "dev:clean": "rm -rf .next && npm rebuild better-sqlite3-multiple-ciphers && npm run dev",
    "postinstall": "npm rebuild better-sqlite3-multiple-ciphers",
    "fc-db-convert": "tsx scripts/fc-db-convert-cli.ts",
    "fc-create-admin": "tsx scripts/fc-create-admin-cli.ts",
    "prebuild": "node scripts/build-changelog.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "pretypecheck": "node scripts/build-changelog.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.3",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "read-excel-file": "^9.3.10",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "js-yaml": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
